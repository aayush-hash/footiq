# Copy this file to .env and fill in your values. Never commit .env to Git.

DATABASE_URL=postgresql+psycopg://footiq:footiq@localhost:5432/footiq

# Where the trained models from the ml folder live
MODELS_DIR=../ml/models

# Day 16: football data provider: "api_football" or "football_data_org"
DATA_PROVIDER=api_football
API_FOOTBALL_KEY=
FOOTBALL_DATA_ORG_KEY=

# Day 17: run the daily sync + predictions job inside the server
ENABLE_SCHEDULER=false
SCHEDULER_HOUR=6
TIMEZONE=Asia/Kathmandu

# Day 20: secret used to sign login tokens. Make a new one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=10080
